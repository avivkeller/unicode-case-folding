{
  "name": "unicode-packages",
  "private": true,
  "description": "JavaScript packages generated from the Unicode Character Database and the Unicode CLDR",
  "type": "module",
  "workspaces": [
    "packages/internal/*"
  ],
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning packages/internal/build/src/build.mjs",
    "test": "node --test \"packages/*/*/test/**/*.test.mjs\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "node packages/internal/build/src/release.mjs"
  },
  "author": "Aviv Keller <me@aviv.sh>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avivkeller/unicode-packages.git"
  },
  "bugs": {
    "url": "https://github.com/avivkeller/unicode-packages/issues"
  },
  "homepage": "https://github.com/avivkeller/unicode-packages",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "globals": "^17.0.0",
    "nanotar": "^0.3.0",
    "prettier": "^3.6.2",
    "rolldown": "^1.3.4",
    "rolldown-plugin-dts": "^0.30.2",
    "semver": "^7.8.6",
    "typescript": "^7.1.0-beta"
  }
}
